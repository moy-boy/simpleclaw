# Bittensor subnet tracker — environment contract.
# Copy to your OpenClaw env (gateway) and fill in. Nothing here is needed to build;
# the detection scripts run offline (channel/send calls degrade gracefully without tokens).

# --- Discord ---
DISCORD_BOT_TOKEN=                         # bot account added to your server (View Channels, Send Messages, Read History)
BT_GUILD_ID=                               # your Discord server (guild) id
BT_ANNOUNCE_CHANNEL=announcement           # channel name for new-subnet announcements
BT_GENERAL_CHANNEL=general                 # fallback channel when a PR's subnet has no channel
BT_CHANNEL_PATTERN=^subnet-(\d+)$          # channel-name -> netuid parser; first capture group is the netuid

# --- Review agent (user-selectable provider + model) ---
BT_REVIEW_MODEL=claude-cli/claude-opus-4-7 # any supported ref: claude-cli/* | anthropic/* | openai-codex/*
BT_TRIAGE_MODEL=                           # optional cheaper model for triage; defaults to BT_REVIEW_MODEL

# --- GitHub (PR monitoring) ---
GITHUB_TOKENS=                             # comma-separated; round-robined + advanced on rate-limit
# GITHUB_TOKEN=                            # single-token alternative

# --- Bittensor netuid source (free / no API key) ---
# Pick ONE. Highest priority first.
BT_SUBNET_SOURCE_CMD=                      # shell command that prints a JSON array of current netuids (e.g. a chain RPC query)
BT_SUBNET_SOURCE_URL=                      # URL returning JSON array, or HTML to scrape (default: https://taostats.io/subnets/)

# --- Cadence ---
BT_PR_POLL_MINUTES=10
BT_REG_POLL_MINUTES=45

# --- Optional ---
BT_OVERRIDE_FILE=                          # path to { "<netuid>": { "repo": "owner/name", "maintainers": ["login"] } }
BT_STATE_DIR=                              # override state dir (default: $OPENCLAW_STATE_DIR/bittensor-bot)
OPENCLAW_BIN=openclaw                      # openclaw CLI path (for message send)
GH_BIN=gh                                  # gh CLI path
